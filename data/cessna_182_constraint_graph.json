        }
      ],
      "source_doc": "Cessna 182Q POH",
      "source_page": 34,
      "source_section": "Section 7 Airplane & Systems Descriptions",
      "poh_quote": null
    },
    {
      "rule_id": "R009_degraded_fuel_pump_degrades_engine",
      "description": "When fuel pump efficiency drops below 70%, engine RPM and power reduce proportionally.",
      "conditions": [
        {
          "node_id": "fuel_pump",
          "attribute": "status",
          "operator": "eq",
          "value": "degraded"
