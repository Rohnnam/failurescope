  "cascade_rules": [
    {
      "rule_id": "R001_alternator_fail_voltage_drop",
      "description": "When alternator fails, bus voltage drops from 14V to 12V (battery). Battery becomes sole power source. Discharge begins.",
      "conditions": [
        {
          "node_id": "alternator",
          "attribute": "status",
          "operator": "eq",
          "value": "failed"
        }
      ],
      "effects": [
        {
          "node_id": "electrical_bus",
          "attribute": "current_value",
          "operation": "set",
          "value": 12.0,
          "cascade_type": "immediate",
          "rate_per_second": null
        },
        {
          "node_id": "battery",
          "attribute": "status",
          "operation": "set",
          "value": "degraded",
          "cascade_type": "immediate",
          "rate_per_second": null
        }
      ],
      "source_doc": "Cessna 182Q POH",
      "source_page": 38,
      "source_section": "Section 3 Emergency Procedures \u2014 Electrical Power Malfunctions",
      "poh_quote": "A broken alternator drive belt or wiring is most likely the cause of alternator failures. Problems of this nature constitute an electrical emergency and should be dealt with immediately."
    },
    {
      "rule_id": "R002_battery_discharge",
      "description": "Battery discharges continuously when alternator is failed. At typical 15.0A load: ~132 min runtime.",
      "conditions": [
        {
          "node_id": "alternator",
          "attribute": "status",
          "operator": "eq",
          "value": "failed"
        },
        {
          "node_id": "battery",
          "attribute": "current_value",
          "operator": "gt",
          "value": 0.0
        }
      ],
      "effects": [
        {
          "node_id": "battery",
          "attribute": "current_value",
          "operation": "subtract",
          "value": 0.00012626262626262626,
          "cascade_type": "gradual",
          "rate_per_second": 0.00012626262626262626
        }
      ],
      "source_doc": "Cessna 182 Service Manual D2006R4-13",
      "source_page": 248,
      "source_section": "Section 16 Electrical Systems \u2014 Battery",
      "poh_quote": "The battery is 12-volts and is approximately 33 ampere hour capacity."
    },
    {
      "rule_id": "R003_low_voltage_degrades_fuel_pump",
      "description": "When bus voltage drops below 11.5V, electric fuel pump efficiency degrades by 20%. Fuel flow reduces proportionally.",
      "conditions": [
        {
          "node_id": "electrical_bus",
          "attribute": "current_value",
          "operator": "lt",
          "value": 11.5
        },
        {
          "node_id": "fuel_pump",
          "attribute": "status",
          "operator": "eq",
          "value": "normal"
        }
      ],
      "effects": [
        {
          "node_id": "fuel_pump",
          "attribute": "current_value",
          "operation": "multiply",
          "value": 0.8,
          "cascade_type": "gradual",
          "rate_per_second": null
        },
        {
          "node_id": "fuel_pump",
          "attribute": "status",
          "operation": "set",
          "value": "degraded",
          "cascade_type": "immediate",
          "rate_per_second": null
        }
      ],
      "source_doc": "FAA AC 43.13-1B",
      "source_page": null,
      "source_section": "Section 11 Electrical Systems \u2014 12V Motor Minimum Operating Voltage",
      "poh_quote": "The electric fuel pump requires adequate voltage for proper operation. Degraded voltage results in reduced pump efficiency and fuel flow."
    },
    {
      "rule_id": "R004_critical_voltage_fuel_pump_fails",
      "description": "When bus voltage drops below 10.5V (minimum operating), electric fuel pump fails completely. Engine loses fuel supply.",
      "conditions": [
        {
          "node_id": "electrical_bus",
          "attribute": "current_value",
          "operator": "lt",
          "value": 10.5
        }
      ],
      "effects": [
        {
          "node_id": "fuel_pump",
          "attribute": "status",
          "operation": "set",
          "value": "failed",
          "cascade_type": "immediate",
          "rate_per_second": null
        },
        {
          "node_id": "fuel_pump",
          "attribute": "current_value",
          "operation": "set",
          "value": 0.0,
          "cascade_type": "immediate",
          "rate_per_second": null
        }
      ],
      "source_doc": "FAA AC 43.13-1B",
      "source_page": null,
      "source_section": "Section 11 \u2014 Minimum operating voltage for 12V electrical motors",
      "poh_quote": null
    },
    {
      "rule_id": "R005_no_fuel_pump_engine_loses_power",
      "description": "When fuel pump fails completely, engine loses fuel supply. Engine RPM drops proportionally to fuel flow reduction.",
      "conditions": [
        {
          "node_id": "fuel_pump",
          "attribute": "status",
          "operator": "eq",
          "value": "failed"
        },
        {
          "node_id": "engine",
          "attribute": "status",
          "operator": "eq",
          "value": "normal"
        }
      ],
      "effects": [
        {
          "node_id": "engine",
          "attribute": "status",
          "operation": "set",
          "value": "degraded",
          "cascade_type": "immediate",
          "rate_per_second": null
        },
        {
          "node_id": "engine",
          "attribute": "current_value",
          "operation": "multiply",
          "value": 0.0,
          "cascade_type": "gradual",
          "rate_per_second": 50.0
        }
      ],
      "source_doc": "Cessna 182Q POH",
      "source_page": 27,
      "source_section": "Section 3 Emergency Procedures \u2014 Engine Failure",
      "poh_quote": "Engine failure during flight: (1) airspeed \u2014 maintain best glide. (2) fuel selector valve \u2014 switch tanks. (3) electric fuel pump \u2014 ON."
    },
    {
      "rule_id": "R006_engine_stop_alternator_stops",
      "description": "When engine stops (RPM = 0), alternator output drops to 0. Battery becomes sole power source if not already.",
      "conditions": [
        {
          "node_id": "engine",
          "attribute": "current_value",
          "operator": "lte",
          "value": 0.0
        }
      ],
      "effects": [
        {
          "node_id": "alternator",
          "attribute": "current_value",
          "operation": "set",
          "value": 0.0,
          "cascade_type": "immediate",
          "rate_per_second": null
        },
        {
          "node_id": "engine",
          "attribute": "status",
          "operation": "set",
          "value": "failed",
          "cascade_type": "immediate",
          "rate_per_second": null
        },
        {
          "node_id": "thrust",
          "attribute": "current_value",
          "operation": "set",
          "value": 0.0,
          "cascade_type": "immediate",
          "rate_per_second": null
        }
      ],
      "source_doc": "Cessna 182Q POH",
      "source_page": 27,
      "source_section": "Section 3 Emergency Procedures",
      "poh_quote": null
    },
    {
      "rule_id": "R007_vacuum_pump_fail_gyros_fail",
      "description": "When vacuum pump fails, attitude indicator and directional indicator become unreliable within 30-60 seconds (gyro rundown).",
      "conditions": [
        {
          "node_id": "vacuum_pump",
          "attribute": "status",
          "operator": "eq",
          "value": "failed"
        }
      ],
      "effects": [
        {
          "node_id": "attitude_indicator",
          "attribute": "status",
          "operation": "set",
          "value": "unreliable",
          "cascade_type": "gradual",
          "rate_per_second": 0.016
        },
        {
          "node_id": "directional_indicator",
          "attribute": "status",
          "operation": "set",
          "value": "unreliable",
          "cascade_type": "gradual",
          "rate_per_second": 0.016
        }
      ],
      "source_doc": "Cessna 182Q POH",
      "source_page": 34,
      "source_section": "Section 3 Emergency Procedures \u2014 Instrument Failure",
      "poh_quote": "The directional indicator and attitude indicator will be disabled, and the pilot will have to rely on the turn coordinator."
    },
    {
      "rule_id": "R008_engine_fail_vacuum_fail",
      "description": "Engine failure causes vacuum pump to stop. Gyroscopic instruments begin spinning down.",
      "conditions": [
        {
          "node_id": "engine",
          "attribute": "status",
